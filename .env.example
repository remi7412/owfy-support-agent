# ==========================================
# Owfy Enterprise AI Support Agent - Environment
# ==========================================

# Groq LLM API (Get free API key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Admin Authentication
ADMIN_USER=admin
ADMIN_PASS=change_this_secure_password
ADMIN_SECRET=generate_a_random_32_char_secret_string

# Email Escalation & Notifications (SMTP over SSL port 465 or STARTTLS port 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=support@yourdomain.com
SMTP_PASS=your_gmail_app_password_here
SUPPORT_EMAIL=team@yourdomain.com

# CORS Allowed Origins (comma-separated, no trailing slashes)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://yourdomain.com

# Database Path (defaults to ./support_agent.db locally, /data/support_agent.db in Docker)
# DB_PATH=/data/support_agent.db
